# Copy to .env.local (gitignored) and fill in. NEVER paste a real secret into
# chat or a ticket — anything that has appeared in a transcript is burned and
# must be rotated. See SECURITY.md.

# ---- Public, safe to commit (already in .env.production) ----
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable key>

# ---- Two-step verification ----
# Makes enrolment MANDATORY for every organizer. Leave unset until TOTP is
# enabled in Supabase (Authentication -> Multi-Factor) and every organizer has
# enrolled, or people land on an enrolment page they must finish first.
# Enforcement for people who have ALREADY enrolled needs no flag — it is
# always on.
# MFA_REQUIRED=on

# ---- Sign-in CAPTCHA (set at most one; hCaptcha wins if both) ----
# Rollout order matters: deploy the SITE key, have a HUMAN confirm the widget
# passes in a normal browser, and only then enable CAPTCHA protection in
# Supabase (Authentication -> Attack Protection) with the SECRET.
# The secret goes in the Supabase dashboard ONLY — never here, never Vercel.
# Turnstile: site key 24 chars, secret 35 chars, both start 0x4AAA — count the
# characters before using one, they are easy to swap.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# NEXT_PUBLIC_HCAPTCHA_SITE_KEY=

# ---- AI sheet scanning (Vercel AI Gateway) ----
# Nothing to set in production: on Vercel the scan route authenticates to the
# gateway with the deployment's own OIDC token. For local development, run
# `vercel env pull` (writes VERCEL_OIDC_TOKEN, valid ~12h) — or set a gateway
# key below, which takes precedence over OIDC everywhere it is set.
# AI_GATEWAY_API_KEY=

# ---- Server-side secrets are NOT here ----
# The Supabase service-role key, the Airtable token and the Resend key are
# used only by Edge Functions. They live in Supabase Vault and never reach the
# browser or this file.
